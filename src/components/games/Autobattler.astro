---
import enemySprite from "../../assets/game/enemy.png";
import grassTexture from "../../assets/game/grass.png";
import playerSprite from "../../assets/game/player.png";
import potionIcon from "../../assets/game/potion.png";
import shieldIcon from "../../assets/game/shield.png";
import swordIcon from "../../assets/game/sword.png";
import trophyIcon from "../../assets/game/trophy.png";
import Button from "../Button.astro";

const winSlots = Array.from({ length: 10 }, (_, index) => index);
---

<games-break
  class="block space-y-5"
  data-icon-attack={swordIcon.src}
  data-icon-defend={shieldIcon.src}
  data-icon-heal={potionIcon.src}
>
  <div
    class="relative min-h-56 overflow-hidden border border-dashed border-border p-4"
    data-arena
  >
    <div class="hidden gap-1" aria-label="wins" data-wins-row>
      {
        winSlots.map((slot) => (
          <span class="grid size-5 place-items-center" data-win-slot={slot}>
            <img
              class="hidden size-4 object-contain [image-rendering:pixelated]"
              src={trophyIcon.src}
              alt=""
              loading="lazy"
              data-win-trophy
            />
          </span>
        ))
      }
    </div>

    <div class="mt-9" data-upgrade-scene>
      <div class="relative h-20">
        <img
          class="absolute -top-2 left-0 size-14 -scale-x-100 object-contain [image-rendering:pixelated]"
          src={playerSprite.src}
          alt=""
          loading="lazy"
        />
        <img
          class="absolute -top-1 right-2 size-14 -scale-x-100 object-contain [image-rendering:pixelated]"
          src={enemySprite.src}
          alt=""
          loading="lazy"
        />
        <div
          class="absolute right-0 bottom-0 left-0 h-8 bg-size-[auto_100%] bg-bottom-left bg-repeat-x"
          style={`background-image: url(${grassTexture.src}); image-rendering: pixelated;`}
        >
        </div>
      </div>
    </div>

    <div class="hidden" data-battle-scene>
      <div class="relative mt-3 h-34">
        <svg
          class="absolute inset-0 h-full w-full text-border"
          viewBox="0 0 500 140"
          preserveAspectRatio="none"
          fill="none"
          aria-hidden="true"
        >
          <path d="M18 96H482" stroke="currentColor" stroke-width="2"></path>
        </svg>
        <div class="absolute top-0 left-1 flex items-start gap-3">
          <img
            class="size-12 -scale-x-100 object-contain [image-rendering:pixelated]"
            src={playerSprite.src}
            alt=""
            loading="lazy"
          />
          <p class="font-headline text-xs font-black dark:font-bold">
            HP: <span data-player-hp>100</span> def:
            <span data-player-def>5</span> atk:
            <span data-player-atk>10</span>
          </p>
        </div>
        <span
          class="absolute top-[5.3rem] left-1/2 -translate-x-1/2 border border-accent bg-accent/20 px-1 font-headline text-xs font-black dark:font-bold"
        >
          VS
        </span>
        <div class="absolute top-11 right-1 flex items-end gap-3">
          <p class="font-headline text-xs font-black dark:font-bold">
            HP: <span data-enemy-hp>35</span> def:
            <span data-enemy-def>0</span> atk:
            <span data-enemy-atk>8</span>
          </p>
          <img
            class="size-12 -scale-x-100 object-contain [image-rendering:pixelated]"
            src={enemySprite.src}
            alt=""
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="hidden py-8 text-center" data-win-scene>
      <p class="font-headline text-sm font-black dark:font-bold">10/10</p>
      <p class="mt-3 text-sm">Well damn, the score is just like you are</p>
      <div class="mx-auto mt-5 flex justify-center gap-1">
        {
          winSlots.map(() => (
            <img
              class="size-4 object-contain [image-rendering:pixelated]"
              src={trophyIcon.src}
              alt=""
              loading="lazy"
            />
          ))
        }
      </div>
    </div>

    <div class="hidden py-8 text-center" data-lose-scene>
      <p class="font-headline text-sm font-black dark:font-bold">
        GG you tried your best
      </p>
      <p class="mt-3 font-headline text-sm font-black dark:font-bold">
        <span data-final-wins>0</span>/10
      </p>
      <div
        class="mx-auto mt-5 grid size-16 place-items-center rounded-full border border-accent bg-accent/10 text-accent"
      >
        <img
          class="size-12 -scale-x-100 object-contain opacity-60 grayscale [image-rendering:pixelated]"
          src={playerSprite.src}
          alt=""
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <div class="space-y-3" data-upgrade-panel>
    <p class="text-center font-headline text-sm font-black dark:font-bold">
      choose an upgrade
    </p>
    <div class="grid gap-3 sm:grid-cols-3">
      {
        [0, 1, 2].map((index) => (
          <div>
            <Button
              class="min-h-14 w-full whitespace-normal"
              variant="secondary"
              size="sm"
              type="button"
              data-upgrade={index}
            >
              <img
                class="size-5 object-contain [image-rendering:pixelated]"
                src={swordIcon.src}
                alt=""
                data-upgrade-icon
              />
              <span data-upgrade-label>Upgrade</span>
            </Button>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hidden grid-cols-3 gap-3" data-action-panel>
    <Button variant="secondary" size="sm" type="button" data-action="attack">
      <img
        slot="icon"
        src={swordIcon.src}
        alt=""
        class="size-4 object-contain [image-rendering:pixelated]"
      />
      atk
    </Button>
    <Button variant="secondary" size="sm" type="button" data-action="defend">
      <img
        slot="icon"
        src={shieldIcon.src}
        alt=""
        class="size-4 object-contain [image-rendering:pixelated]"
      />
      def
    </Button>
    <Button variant="secondary" size="sm" type="button" data-action="heal">
      <img
        slot="icon"
        src={potionIcon.src}
        alt=""
        class="size-4 object-contain [image-rendering:pixelated]"
      />
      heal
    </Button>
  </div>

  <div class="hidden justify-center" data-end-panel>
    <Button variant="secondary" size="sm" type="button" data-reset>
      try again
    </Button>
  </div>

  <p
    class="min-h-10 text-center text-sm leading-relaxed text-muted-foreground"
    data-log
  >
  </p>
</games-break>

<script>
  type UpgradeIcon = "attack" | "defend" | "heal";
  type Upgrade = {
    label: string;
    icon: UpgradeIcon;
    apply: (player: PlayerState) => void;
  };

  type PlayerState = {
    hp: number;
    maxHp: number;
    def: number;
    atk: number;
    heal: number;
    firstMiss: boolean;
    firstMissReady: boolean;
    drain: number;
    desperation: number;
    guardHeal: number;
    startArmor: number;
    armor: number;
  };

  type EnemyState = {
    hp: number;
    maxHp: number;
    def: number;
    atk: number;
  };

  class GamesBreakElement extends HTMLElement {
    private player: PlayerState = this.freshPlayer();
    private enemy: EnemyState = this.makeEnemy();
    private offered: Upgrade[] = [];
    private wins = 0;
    private phase: "upgrade" | "battle" | "done" = "upgrade";
    private iconUrls = {
      attack: this.dataset.iconAttack ?? "",
      defend: this.dataset.iconDefend ?? "",
      heal: this.dataset.iconHeal ?? "",
    } satisfies Record<UpgradeIcon, string>;

    connectedCallback() {
      this.bindEvents();
      this.reset();
    }

    private bindEvents() {
      this.$$<HTMLElement>("[data-upgrade]").forEach((button) => {
        button.addEventListener("click", () => {
          if (this.phase !== "upgrade") return;
          const index = Number(button.dataset.upgrade);
          this.offered[index]?.apply(this.player);
          this.startBattle();
        });
      });

      this.$$<HTMLElement>("[data-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const action = button.dataset.action;
          if (action === "attack" || action === "defend" || action === "heal") {
            this.act(action);
          }
        });
      });

      this.$$<HTMLElement>("[data-reset]").forEach((button) => {
        button.addEventListener("click", () => this.reset());
      });
    }

    private upgrades(): Upgrade[] {
      return [
        { label: "Heal +10", icon: "heal", apply: (p) => (p.heal += 10) },
        { label: "ATK +5", icon: "attack", apply: (p) => (p.atk += 5) },
        { label: "DEF +5", icon: "defend", apply: (p) => (p.def += 5) },
        {
          label: "First hit misses",
          icon: "defend",
          apply: (p) => (p.firstMiss = true),
        },
        {
          label: "Max HP +20",
          icon: "heal",
          apply: (p) => {
            p.maxHp += 20;
            p.hp += 20;
          },
        },
        {
          label: "Attack heals 5",
          icon: "attack",
          apply: (p) => (p.drain += 5),
        },
        {
          label: "+8 ATK under half HP",
          icon: "attack",
          apply: (p) => (p.desperation += 8),
        },
        {
          label: "Def heals 8",
          icon: "defend",
          apply: (p) => (p.guardHeal += 8),
        },
        {
          label: "Armor +12 each fight",
          icon: "defend",
          apply: (p) => (p.startArmor += 12),
        },
      ];
    }

    private freshPlayer(): PlayerState {
      return {
        hp: 100,
        maxHp: 100,
        def: 5,
        atk: 5,
        heal: 20,
        firstMiss: false,
        firstMissReady: false,
        drain: 0,
        desperation: 0,
        guardHeal: 0,
        startArmor: 0,
        armor: 0,
      };
    }

    private makeEnemy(): EnemyState {
      return {
        maxHp: 15 + this.wins * 12,
        hp: 15 + this.wins * 12,
        def: Math.floor(this.wins / 2) * 2,
        atk: 5 + this.wins * 3,
      };
    }

    private $(selector: string): HTMLElement | null {
      return this.querySelector(selector);
    }

    private $$<T extends Element>(selector: string): T[] {
      return Array.from(this.querySelectorAll<T>(selector));
    }

    private clamp(value: number, max: number): number {
      return Math.max(0, Math.min(value, max));
    }

    private setText(selector: string, value: number | string) {
      const element = this.$(selector);
      if (element) element.textContent = String(value);
    }

    private setVisible(
      selector: string,
      visible: boolean,
      display: "block" | "grid" | "flex" = "block",
    ) {
      const element = this.$(selector);
      if (!(element instanceof HTMLElement)) return;
      element.classList.toggle("hidden", !visible);
      element.classList.remove("grid", "flex", "block");
      if (visible) element.classList.add(display);
    }

    private offerUpgrades() {
      this.phase = "upgrade";
      this.offered = this.upgrades()
        .map((upgrade) => [Math.random(), upgrade] as const)
        .sort(([a], [b]) => a - b)
        .slice(0, 3)
        .map(([, upgrade]) => upgrade);

      this.$$<HTMLElement>("[data-upgrade]").forEach((button, index) => {
        const upgrade = this.offered[index];
        const label = button.querySelector<HTMLElement>("[data-upgrade-label]");
        const icon = button.querySelector<HTMLImageElement>(
          "[data-upgrade-icon]",
        );
        if (!upgrade) return;
        if (label) label.textContent = upgrade.label;
        if (icon) icon.src = this.iconUrls[upgrade.icon];
      });

      this.setVisible("[data-upgrade-scene]", true);
      this.setVisible("[data-wins-row]", true, "flex");
      this.setVisible("[data-battle-scene]", false);
      this.setVisible("[data-win-scene]", false);
      this.setVisible("[data-lose-scene]", false);
      this.setVisible("[data-upgrade-panel]", true);
      this.setVisible("[data-action-panel]", false);
      this.setVisible("[data-end-panel]", false);
      this.setText("[data-log]", "");
      this.render();
    }

    private startBattle() {
      this.phase = "battle";
      this.enemy = this.makeEnemy();
      this.player.armor = this.player.startArmor;
      this.player.firstMissReady = this.player.firstMiss;
      this.setVisible("[data-wins-row]", false);
      this.setVisible("[data-upgrade-scene]", false);
      this.setVisible("[data-battle-scene]", true);
      this.setVisible("[data-upgrade-panel]", false);
      this.setVisible("[data-action-panel]", true, "grid");
      this.setText("[data-log]", `Fight ${this.wins + 1}. Choose a move.`);
      this.render();
    }

    private enemyTurn(guarding = false): string {
      if (this.enemy.hp <= 0) return "Enemy down.";
      if (this.player.firstMissReady) {
        this.player.firstMissReady = false;
        return "Enemy misses.";
      }

      const defense = this.player.def * (guarding ? 2 : 1);
      let damage = Math.max(1, this.enemy.atk - defense);
      const blockedByArmor = Math.min(this.player.armor, damage);
      this.player.armor -= blockedByArmor;
      damage -= blockedByArmor;
      this.player.hp = this.clamp(this.player.hp - damage, this.player.maxHp);
      return damage > 0 ? `Enemy hits for ${damage}.` : "Armor absorbs it.";
    }

    private finishTurn(message: string) {
      if (this.enemy.hp <= 0) {
        this.wins += 1;
        if (this.wins >= 10) {
          this.phase = "done";
          this.setVisible("[data-wins-row]", false);
          this.setVisible("[data-battle-scene]", false);
          this.setVisible("[data-win-scene]", true);
          this.setVisible("[data-action-panel]", false);
          this.setVisible("[data-end-panel]", true, "flex");
          this.setText("[data-log]", "");
        } else {
          this.offerUpgrades();
          this.setText("[data-log]", `${message} Win secured.`);
        }
        this.render();
        return;
      }

      if (this.player.hp <= 0) {
        this.phase = "done";
        this.setVisible("[data-wins-row]", false);
        this.setVisible("[data-battle-scene]", false);
        this.setVisible("[data-lose-scene]", true);
        this.setVisible("[data-action-panel]", false);
        this.setVisible("[data-upgrade-panel]", false);
        this.setVisible("[data-end-panel]", true, "flex");
        this.setText("[data-final-wins]", this.wins);
        this.setText("[data-log]", "");
        this.render();
        return;
      }

      this.setText("[data-log]", message);
      this.render();
    }

    private act(action: "attack" | "defend" | "heal") {
      if (this.phase !== "battle") return;

      if (action === "attack") {
        const bonus =
          this.player.hp < this.player.maxHp / 2 ? this.player.desperation : 0;
        const damage = Math.max(1, this.player.atk + bonus - this.enemy.def);
        this.enemy.hp = this.clamp(this.enemy.hp - damage, this.enemy.maxHp);
        this.player.hp = this.clamp(
          this.player.hp + this.player.drain,
          this.player.maxHp,
        );
        this.finishTurn(`You hit for ${damage}. ${this.enemyTurn(false)}`);
        return;
      }

      if (action === "defend") {
        this.player.hp = this.clamp(
          this.player.hp + this.player.guardHeal,
          this.player.maxHp,
        );
        this.finishTurn(`You defend. ${this.enemyTurn(true)}`);
        return;
      }

      this.player.hp = this.clamp(
        this.player.hp + this.player.heal,
        this.player.maxHp,
      );
      this.finishTurn(`You heal ${this.player.heal}. ${this.enemyTurn(false)}`);
    }

    private render() {
      this.setText("[data-player-hp]", this.player.hp);
      this.setText("[data-player-def]", this.player.def + this.player.armor);
      this.setText("[data-player-atk]", this.player.atk);
      this.setText("[data-enemy-hp]", this.enemy.hp);
      this.setText("[data-enemy-def]", this.enemy.def);
      this.setText("[data-enemy-atk]", this.enemy.atk);
      this.$$<HTMLElement>("[data-win-slot]").forEach((slot, index) => {
        const trophy = slot.querySelector<HTMLElement>("[data-win-trophy]");
        trophy?.classList.toggle("hidden", index >= this.wins);
      });
    }

    private reset() {
      this.player = this.freshPlayer();
      this.wins = 0;
      this.enemy = this.makeEnemy();
      this.offerUpgrades();
    }
  }

  if (!customElements.get("games-break")) {
    customElements.define("games-break", GamesBreakElement);
  }
</script>
