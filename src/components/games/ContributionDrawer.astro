---
import { Download, Eraser, Shuffle } from "@lucide/astro";
import Button from "../Button.astro";
import { CONFIG, type ContributionDrawerGame } from "../../consts";

const config = CONFIG.game.options as ContributionDrawerGame;

const rows = config.options.rows;
const columns = config.options.cols;
const cells = Array.from({ length: rows * columns }, (_, index) => index);
---

<contribution-drawer
  class="block space-y-5"
  data-rows={rows}
  data-columns={columns}
>
  <div
    class="overflow-hidden border border-dashed border-border bg-muted/35 p-3 sm:p-4"
  >
    <div
      class="grid touch-none gap-1"
      style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr));`}
      data-grid
      aria-label="drawing grid"
    >
      {
        cells.map((cell) => (
          <button
            class="aspect-square min-w-0 rounded-xs border border-border bg-background transition-[background-color,border-color,transform] duration-100 hover:scale-110 hover:border-accent focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-accent data-[filled=true]:border-accent data-[filled=true]:bg-accent"
            type="button"
            aria-label={`toggle cell ${cell + 1}`}
            aria-pressed="false"
            data-cell={cell}
          />
        ))
      }
    </div>
  </div>

  <div class="flex flex-wrap justify-end gap-3">
    <div class="flex flex-wrap gap-2">
      <Button variant="secondary" size="sm" type="button" data-random>
        <Shuffle slot="icon" />
        scatter
      </Button>
      <Button variant="secondary" size="sm" type="button" data-erase>
        <Eraser slot="icon" />
        erase
      </Button>
      <Button variant="accent" size="sm" type="button" data-save>
        <Download slot="icon" />
        png
      </Button>
    </div>
  </div>
</contribution-drawer>

<script>
  class ContributionDrawerElement extends HTMLElement {
    private cells: HTMLButtonElement[] = [];
    private isPointerDown = false;
    private paintFilled = true;
    private lastPaintedCell: HTMLButtonElement | null = null;

    connectedCallback() {
      this.cells = this.$$<HTMLButtonElement>("[data-cell]");
      this.bindEvents();
    }

    private bindEvents() {
      this.cells.forEach((cell) => {
        cell.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          this.isPointerDown = true;
          this.paintFilled = cell.dataset.filled !== "true";
          this.paint(cell, this.paintFilled);
        });

        cell.addEventListener("pointermove", (event) => {
          if (!this.isPointerDown) return;
          const target = document.elementFromPoint(
            event.clientX,
            event.clientY,
          );
          const targetCell = target?.closest<HTMLButtonElement>("[data-cell]");
          if (targetCell && this.contains(targetCell)) {
            this.paint(targetCell, this.paintFilled);
          }
        });

        cell.addEventListener("pointerup", () => {
          this.isPointerDown = false;
          this.lastPaintedCell = null;
        });
      });

      window.addEventListener("pointerup", () => {
        this.isPointerDown = false;
        this.lastPaintedCell = null;
      });

      this.$("[data-erase]")?.addEventListener("click", () => this.erase());
      this.$("[data-random]")?.addEventListener("click", () => this.scatter());
      this.$("[data-save]")?.addEventListener("click", () => this.savePng());
    }

    private $(selector: string): HTMLElement | null {
      return this.querySelector(selector);
    }

    private $$<T extends Element>(selector: string): T[] {
      return Array.from(this.querySelectorAll<T>(selector));
    }

    private paint(cell: HTMLButtonElement, filled: boolean) {
      if (
        this.lastPaintedCell === cell &&
        cell.dataset.filled === String(filled)
      ) {
        return;
      }
      this.lastPaintedCell = cell;
      cell.dataset.filled = String(filled);
      cell.setAttribute("aria-pressed", String(filled));
    }

    private erase() {
      this.paintFilled = false;
      this.cells.forEach((cell) => this.paint(cell, false));
    }

    private scatter() {
      this.cells.forEach((cell) => {
        this.paint(cell, Math.random() > 0.72);
      });
    }

    private savePng() {
      const rows = Number(this.dataset.rows ?? 7);
      const columns = Number(this.dataset.columns ?? 28);
      const cellSize = 24;
      const gap = 4;
      const padding = 16;
      const width = columns * cellSize + (columns - 1) * gap + padding * 2;
      const height = rows * cellSize + (rows - 1) * gap + padding * 2;
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;

      const context = canvas.getContext("2d");
      if (!context) return;

      const isDark = document.documentElement.classList.contains("dark");
      const emptyColor = this.resolveThemeColor(
        "--background",
        isDark ? "#0c0a09" : "#fafaf9",
      );
      const filledColor = this.resolveThemeColor(
        "--accent-color",
        isDark ? "#5eead4" : "#0f766e",
      );
      const borderColor = this.resolveThemeColor(
        "--border",
        isDark ? "#292524" : "#e7e5e4",
      );
      const surfaceColor = this.resolveThemeColor(
        "--muted",
        isDark ? "#1c1917" : "#f5f5f4",
      );

      context.fillStyle = surfaceColor;
      context.fillRect(0, 0, width, height);

      this.cells.forEach((cell, index) => {
        const x = padding + (index % columns) * (cellSize + gap);
        const y = padding + Math.floor(index / columns) * (cellSize + gap);
        const filled =
          cell.dataset.filled === "true" ||
          cell.getAttribute("aria-pressed") === "true";
        context.fillStyle = filled ? filledColor : emptyColor;
        context.fillRect(x, y, cellSize, cellSize);
        context.strokeStyle = borderColor;
        context.strokeRect(x + 0.5, y + 0.5, cellSize - 1, cellSize - 1);
      });

      const link = document.createElement("a");
      link.download = "contribution-drawing.png";
      link.href = canvas.toDataURL("image/png");
      link.click();
    }

    private resolveThemeColor(property: string, fallback: string): string {
      const probe = document.createElement("span");
      probe.style.color = `var(${property})`;
      probe.style.position = "fixed";
      probe.style.pointerEvents = "none";
      probe.style.visibility = "hidden";
      document.body.append(probe);
      const color = getComputedStyle(probe).color;
      probe.remove();
      return this.toCanvasColor(color, fallback);
    }

    private toCanvasColor(color: string, fallback: string): string {
      if (this.canvasAcceptsColor(color)) return color;

      const oklch = color.match(
        /^oklch\(\s*([\d.]+%?)\s+([\d.]+)\s+([\d.]+)(?:deg)?(?:\s*\/\s*([\d.]+%?))?\s*\)$/i,
      );
      if (!oklch) return fallback;

      const lightness = this.parsePercentableNumber(oklch[1], 1);
      const chroma = Number(oklch[2]);
      const hue = (Number(oklch[3]) * Math.PI) / 180;
      const alpha =
        oklch[4] === undefined ? 1 : this.parsePercentableNumber(oklch[4], 1);
      const a = chroma * Math.cos(hue);
      const b = chroma * Math.sin(hue);

      const lPrime = lightness + 0.3963377774 * a + 0.2158037573 * b;
      const mPrime = lightness - 0.1055613458 * a - 0.0638541728 * b;
      const sPrime = lightness - 0.0894841775 * a - 1.291485548 * b;

      const l = lPrime ** 3;
      const m = mPrime ** 3;
      const s = sPrime ** 3;

      const red = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
      const green = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
      const blue = -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s;

      return `rgba(${this.toSrgbByte(red)}, ${this.toSrgbByte(green)}, ${this.toSrgbByte(blue)}, ${alpha})`;
    }

    private canvasAcceptsColor(color: string): boolean {
      const canvas = document.createElement("canvas");
      const context = canvas.getContext("2d");
      if (!context) return false;
      context.fillStyle = "#000001";
      context.fillStyle = color;
      return context.fillStyle !== "#000001";
    }

    private parsePercentableNumber(value: string, max: number): number {
      return value.endsWith("%")
        ? (Number.parseFloat(value) / 100) * max
        : Number(value);
    }

    private toSrgbByte(linear: number): number {
      const clamped = Math.max(0, Math.min(1, linear));
      const corrected =
        clamped <= 0.0031308
          ? 12.92 * clamped
          : 1.055 * clamped ** (1 / 2.4) - 0.055;
      return Math.round(corrected * 255);
    }
  }

  if (!customElements.get("contribution-drawer")) {
    customElements.define("contribution-drawer", ContributionDrawerElement);
  }
</script>
