---
const pathname = Astro.url.pathname;
const isBlogActive = pathname === "/blog/" || pathname.startsWith("/blog/");
---

<header
    id="site-header"
    class="sticky top-0 z-50 border-b border-border/70 bg-background/90 backdrop-blur transition-all duration-300"
>
    <link rel="prefetch" href="/blog/" />
    <nav
        class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5 transition-all duration-300 sm:px-6"
        aria-label="Primary navigation"
    >
        <a class="font-headline text-xl font-bold text-foreground" href="/">
            DK
        </a>

        <div class="flex items-center gap-2">
            <a
                href="/blog/"
                data-astro-prefetch
                aria-current={isBlogActive ? "page" : undefined}
                class:list={[
                    "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                    isBlogActive
                        ? "bg-accent text-accent-foreground"
                        : "text-muted-foreground hover:text-foreground",
                ]}
            >
                Blog
            </a>

            <button
                class="grid size-9 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:text-foreground"
                type="button"
                aria-label="Toggle theme"
            >
                <span aria-hidden="true">◐</span>
            </button>

            <a
                class="rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-85"
                href="/resume.pdf"
            >
                Resume
            </a>
        </div>
    </nav>
</header>

<script>
    const header = document.querySelector("#site-header");
    const nav = header?.querySelector("nav");

    const syncHeader = () => {
        const isCompact = window.scrollY > 24;

        header?.classList.toggle("shadow-sm", isCompact);
        nav?.classList.toggle("py-5", !isCompact);
        nav?.classList.toggle("py-3", isCompact);
    };

    syncHeader();
    window.addEventListener("scroll", syncHeader, { passive: true });
</script>
