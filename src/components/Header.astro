---
import { BLOG } from "../consts";
import ScrambleLink from "./ScrambleLink.astro";

const pathname = Astro.url.pathname;
const isBlogActive = pathname === "/blog/" || pathname.startsWith("/blog/");
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between px-5 py-2 text-xs text-muted-foreground"
    aria-label="primary navigation"
  >
    <a href="/" class="no-underline">
      <span class="text-foreground">~</span>/kopenkin.tech
    </a>
    <div class="flex items-center gap-4">
      <span class="hidden sm:inline">
        <span class="text-foreground">↑↓</span>/<span class="text-foreground"
          >jk</span
        > move · <span class="text-foreground">enter</span> expand
      </span>
      <ScrambleLink
        href={isBlogActive ? "/" : "/blog/"}
        label={isBlogActive ? "home" : BLOG.title.toLowerCase()}
        external={false}
      />
    </div>
  </nav>
</header>
