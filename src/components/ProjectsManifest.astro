---
import type { ProjectStatus, USER } from "../consts";
import ScrambleLink from "./ScrambleLink.astro";

interface Props {
  projects: typeof USER.projects.entries;
}

const { projects } = Astro.props;

const pinned = projects.find((project) => project.highlighted);
const rest = projects.filter((project) => !project.highlighted);

// One chromatic accent only: "live" carries the accent, everything else
// is distinguished by glyph + weight, never a second color.
const STATUS: Record<
  ProjectStatus,
  { glyph: string; label: string; tone: string }
> = {
  live: { glyph: "●", label: "live", tone: "text-accent" },
  active: { glyph: "◐", label: "active", tone: "text-foreground" },
  archived: { glyph: "○", label: "archived", tone: "text-muted-foreground" },
  experiment: {
    glyph: "◌",
    label: "experiment",
    tone: "text-muted-foreground",
  },
};
---

<div class="block">
  {
    pinned && (
      <article class="mb-8 border-l-2 border-accent pl-4">
        <p class="mb-2 flex items-center gap-2 text-xs tracking-widest text-accent">
          <span aria-hidden="true">★</span>
          pinned
        </p>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-medium text-foreground">{pinned.name}</h3>
          <span
            class:list={[
              "flex shrink-0 items-center gap-1.5 text-xs",
              STATUS[pinned.status].tone,
            ]}
          >
            <span aria-hidden="true">{STATUS[pinned.status].glyph}</span>
            {STATUS[pinned.status].label}
          </span>
        </div>
        <p class="mt-2 max-w-[64ch] text-sm leading-relaxed text-pretty text-foreground/90">
          {pinned.description}
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
          {pinned.href && (
            <ScrambleLink href={pinned.href} label="visit" external />
          )}
          {pinned.github && (
            <ScrambleLink href={pinned.github} label="github" external />
          )}
          {pinned.technologies && (
            <span class="flex flex-wrap gap-x-3 gap-y-1 text-muted-foreground">
              {pinned.technologies.map((technology) => (
                <span>
                  <span class="text-border">#</span>
                  {technology}
                </span>
              ))}
            </span>
          )}
        </div>
      </article>
    )
  }

  <ul>
    {
      rest.map((project, index) => {
        const status = STATUS[project.status];
        const isLast = index === rest.length - 1;
        return (
          <li class="grid grid-cols-[1.25rem_1fr] gap-x-1 py-3">
            <span aria-hidden="true" class="select-none text-border">
              {isLast ? "└─" : "├─"}
            </span>
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-medium text-foreground">{project.name}</h3>
                <span
                  class:list={[
                    "flex shrink-0 items-center gap-1.5 text-xs",
                    status.tone,
                  ]}
                >
                  <span aria-hidden="true">{status.glyph}</span>
                  {status.label}
                </span>
              </div>
              <p class="mt-1.5 max-w-[64ch] text-sm leading-relaxed text-pretty text-foreground/90">
                {project.description}
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                {project.href && (
                  <ScrambleLink href={project.href} label="visit" external />
                )}
                {project.github && (
                  <ScrambleLink
                    href={project.github}
                    label="github"
                    external
                  />
                )}
                {project.technologies && (
                  <span class="flex flex-wrap gap-x-3 gap-y-1 text-muted-foreground">
                    {project.technologies.map((technology) => (
                      <span>
                        <span class="text-border">#</span>
                        {technology}
                      </span>
                    ))}
                  </span>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>
