---
interface Props {
  text: string;
  fontSize?: number;
  lineHeightRatio?: number;
}

const { text, fontSize = 15, lineHeightRatio = 1.7 } = Astro.props;
---

<pretext-reflow-demo
  class="block select-none"
  text={text}
  font-size={String(fontSize)}
  line-height-ratio={String(lineHeightRatio)}
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -z-10 font-mono opacity-0"
    data-measure
    style={`font-size:${fontSize}px;font-weight:400`}
  >
    Mg
  </span>
  <p class="sr-only">{text}</p>
  <div class="relative w-full" aria-hidden="true" data-wrap>
    <div class="relative" data-column style="width:62%">
      <canvas class="block" data-canvas></canvas>
      <button
        type="button"
        aria-label="drag or use arrow keys to resize the text column"
        class="absolute top-0 -right-3 flex h-full w-6 cursor-ew-resize items-center justify-center bg-transparent p-0 text-border outline-none hover:text-accent focus-visible:text-accent"
        data-handle
      >
        <span class="leading-none">┆</span>
      </button>
    </div>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
    <span class="text-accent">// </span>drag the
    <span class="text-foreground">┆</span> edge — relaid live by
    <span class="text-foreground">pretext</span>, no DOM reflow.
    <span class="text-foreground" data-width>0px</span>
    (<span class="text-foreground" data-percent>0%</span>) ·
    <span class="text-foreground" data-lines>0</span> lines · widest
    <span class="text-foreground" data-widest>0px</span>
  </p>
</pretext-reflow-demo>

<script>
  import {
    layoutWithLines,
    prepareWithSegments,
    type PreparedTextWithSegments,
  } from "@chenglou/pretext";

  class PretextReflowDemo extends HTMLElement {
    private canvas?: HTMLCanvasElement;
    private column?: HTMLElement;
    private handle?: HTMLButtonElement;
    private measure?: HTMLElement;
    private wrap?: HTMLElement;
    private prepared?: PreparedTextWithSegments;
    private font = "";
    private color = "#000";
    private fontSize = 15;
    private lineHeight = 26;
    private maxWidth = 0;
    private width = 0;
    private dragging = false;
    private observer?: ResizeObserver;

    connectedCallback() {
      this.canvas = this.querySelector("[data-canvas]") ?? undefined;
      this.column = this.querySelector("[data-column]") ?? undefined;
      this.handle = this.querySelector("[data-handle]") ?? undefined;
      this.measure = this.querySelector("[data-measure]") ?? undefined;
      this.wrap = this.querySelector("[data-wrap]") ?? undefined;

      this.fontSize = Number(this.getAttribute("font-size") ?? 15);
      const lineHeightRatio = Number(
        this.getAttribute("line-height-ratio") ?? 1.7,
      );
      this.lineHeight = Math.round(this.fontSize * lineHeightRatio);

      this.handle?.addEventListener("pointerdown", this.startDrag);
      this.handle?.addEventListener("keydown", this.resizeWithKeyboard);
      window.addEventListener("pointermove", this.drag);
      window.addEventListener("pointerup", this.stopDrag);

      this.init();
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.handle?.removeEventListener("pointerdown", this.startDrag);
      this.handle?.removeEventListener("keydown", this.resizeWithKeyboard);
      window.removeEventListener("pointermove", this.drag);
      window.removeEventListener("pointerup", this.stopDrag);
    }

    private async init() {
      if (!this.measure || !this.wrap) return;
      try {
        await document.fonts?.ready;
      } catch {
        // ignore font readiness failures
      }

      const computed = getComputedStyle(this.measure);
      this.font = `${computed.fontWeight || "400"} ${this.fontSize}px ${computed.fontFamily}`;
      this.color = computed.color;
      this.prepared = prepareWithSegments(
        this.getAttribute("text") ?? "",
        this.font,
      );
      this.syncWidth();

      this.observer = new ResizeObserver(() => this.syncWidth());
      this.observer.observe(this.wrap);
    }

    private syncWidth() {
      if (!this.wrap) return;
      this.maxWidth = Math.floor(this.wrap.clientWidth);
      this.width = Math.min(
        this.width || Math.round(this.maxWidth * 0.62),
        this.maxWidth,
      );
      this.draw();
    }

    private draw() {
      if (!this.canvas || !this.column || !this.prepared) return;
      const context = this.canvas.getContext("2d");
      if (!context) return;

      const width = Math.max(40, this.width);
      const { lines, height } = layoutWithLines(
        this.prepared,
        width,
        this.lineHeight,
      );
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const cssHeight = Math.max(this.lineHeight, height);

      this.canvas.width = Math.ceil(width * ratio);
      this.canvas.height = Math.ceil(cssHeight * ratio);
      this.canvas.style.width = `${width}px`;
      this.canvas.style.height = `${cssHeight}px`;
      this.column.style.width = `${width}px`;

      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, cssHeight);
      context.font = this.font;
      context.fillStyle = this.color;
      context.textBaseline = "alphabetic";

      let widest = 0;
      lines.forEach((line, index) => {
        widest = Math.max(widest, line.width);
        context.fillText(line.text, 0, index * this.lineHeight + this.fontSize);
      });

      this.setStat("width", `${width}px`);
      this.setStat(
        "percent",
        `${this.maxWidth ? Math.round((width / this.maxWidth) * 100) : 0}%`,
      );
      this.setStat("lines", String(lines.length));
      this.setStat("widest", `${Math.round(widest)}px`);
    }

    private setStat(name: string, value: string) {
      const target = this.querySelector(`[data-${name}]`);
      if (target) target.textContent = value;
    }

    private startDrag = (event: PointerEvent) => {
      event.preventDefault();
      this.dragging = true;
      this.handle?.classList.add("text-accent");
    };

    private drag = (event: PointerEvent) => {
      if (!this.dragging || !this.wrap) return;
      const rect = this.wrap.getBoundingClientRect();
      this.width = Math.round(
        Math.min(Math.max(event.clientX - rect.left, 60), rect.width),
      );
      this.draw();
    };

    private stopDrag = () => {
      this.dragging = false;
      this.handle?.classList.remove("text-accent");
    };

    private resizeWithKeyboard = (event: KeyboardEvent) => {
      const step = event.shiftKey ? 24 : 8;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        this.width = Math.max(60, this.width - step);
        this.draw();
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        this.width = Math.min(this.maxWidth, this.width + step);
        this.draw();
      }
    };
  }

  if (!customElements.get("pretext-reflow-demo")) {
    customElements.define("pretext-reflow-demo", PretextReflowDemo);
  }
</script>
