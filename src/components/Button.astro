---
import { cva, type VariantProps } from "class-variance-authority";
import { clsx, type ClassValue } from "clsx";
import { twMerge } from "tailwind-merge";

type ButtonVariants = VariantProps<typeof buttonVariants>;

type Props = {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: ClassValue;
  variant?: ButtonVariants["variant"];
  size?: ButtonVariants["size"];
  disabled?: boolean;
  target?: string;
  rel?: string;
  ariaLabel?: string;
};

const cn = (...inputs: ClassValue[]) => twMerge(clsx(inputs));

const buttonVariants = cva(
  [
    "relative inline-flex shrink-0 translate-y-0 select-none items-center justify-center overflow-hidden rounded-[3px] border font-medium tracking-wider uppercase outline-none transition-[box-shadow,transform,background-color,color,border-color,opacity] duration-150 ease-in-out",
    "shadow-[inset_0_30px_30px_-15px_rgb(255_255_255_/_0.1),inset_0_0_0_1px_rgb(255_255_255_/_0.3),inset_0_1px_20px_rgb(0_0_0_/_0),0_3px_0_var(--button-depth),0_3px_2px_rgb(0_0_0_/_0.2),0_5px_10px_rgb(0_0_0_/_0.1),0_10px_20px_rgb(0_0_0_/_0.1)]",
    "active:translate-y-[3px] active:shadow-[inset_0_16px_2px_-15px_rgb(0_0_0_/_0),inset_0_0_0_1px_rgb(255_255_255_/_0.15),inset_0_1px_20px_rgb(0_0_0_/_0.1),0_0_0_var(--button-depth),0_0_0_2px_rgb(255_255_255_/_0.5),0_0_0_rgb(0_0_0_/_0),0_0_0_rgb(0_0_0_/_0)]",
    "disabled:pointer-events-none disabled:translate-y-0 disabled:cursor-not-allowed disabled:opacity-50",
    "[&_[data-slot=icon]]:shrink-0 [&_[data-slot=icon]>svg]:size-full",
  ],
  {
    variants: {
      variant: {
        primary:
          "border-primary bg-primary text-primary-foreground [--button-depth:var(--primary)] hover:opacity-90",
        accent:
          "border-accent bg-accent text-accent-foreground [--button-depth:var(--accent-color)] hover:opacity-90",
        secondary:
          "border-border bg-muted text-foreground [--button-depth:var(--border)] hover:bg-card",
        ghost:
          "border-transparent bg-transparent text-foreground shadow-none [--button-depth:transparent] hover:bg-muted active:shadow-none",
      },
      size: {
        sm: "h-8 min-w-24 gap-1.5 px-3 text-xs [&_[data-slot=icon]]:size-4",
        md: "h-10 min-w-30 gap-2 px-3 text-sm [&_[data-slot=icon]]:size-5",
        lg: "h-12 min-w-36 gap-2.5 px-5 text-base [&_[data-slot=icon]]:size-6",
        "icon-sm": "size-8 min-w-0 p-0 [&_[data-slot=icon]]:size-4",
        "icon-md": "size-10 min-w-0 p-0 [&_[data-slot=icon]]:size-5",
        "icon-lg": "size-12 min-w-0 p-0 [&_[data-slot=icon]]:size-6",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "md",
    },
  },
);

const {
  href,
  type = "button",
  class: className,
  variant,
  size,
  disabled = false,
  target,
  rel,
  ariaLabel,
} = Astro.props;

const classes = cn(buttonVariants({ variant, size }), className);
const safeRel = target === "_blank" && !rel ? "noreferrer" : rel;
const hasIcon = Astro.slots.has("icon");
---

{
  href ? (
    <a
      class={classes}
      href={disabled ? undefined : href}
      target={target}
      rel={safeRel}
      aria-label={ariaLabel}
      aria-disabled={disabled ? "true" : undefined}
    >
      {hasIcon && (
        <span data-slot="icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
      <slot />
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
    >
      {hasIcon && (
        <span data-slot="icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
      <slot />
    </button>
  )
}
