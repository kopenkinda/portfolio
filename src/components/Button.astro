---
import { cva, type VariantProps } from "class-variance-authority";
import { clsx, type ClassValue } from "clsx";
import { twMerge } from "tailwind-merge";

type ButtonVariants = VariantProps<typeof buttonVariants>;

type Props = {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: ClassValue;
  variant?: ButtonVariants["variant"];
  size?: ButtonVariants["size"];
  disabled?: boolean;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  [key: string]: unknown;
};

const cn = (...inputs: ClassValue[]) => twMerge(clsx(inputs));

const buttonVariants = cva(
  [
    "relative inline-flex shrink-0 translate-y-0 cursor-pointer select-none items-center justify-center whitespace-nowrap rounded-[3px] border px-3 text-center font-normal tracking-[1px] outline-none transition-all duration-150 ease-in-out",
    "border-[var(--button-border)] bg-[var(--button-bg)] text-[var(--button-fg)] [text-shadow:0_1px_0_rgb(0_0_0_/_0.3)]",
    "shadow-[inset_0_30px_30px_-15px_rgb(255_255_255_/_0.1),inset_0_0_0_1px_rgb(255_255_255_/_0.3),inset_0_1px_20px_rgb(0_0_0_/_0),0_3px_0_var(--button-depth),0_3px_2px_rgb(0_0_0_/_0.2),0_5px_10px_rgb(0_0_0_/_0.1),0_10px_20px_rgb(0_0_0_/_0.1)]",
    "active:translate-y-[3px] active:shadow-[inset_0_16px_2px_-15px_rgb(0_0_0_/_0),inset_0_0_0_1px_rgb(255_255_255_/_0.15),inset_0_1px_20px_rgb(0_0_0_/_0.1),0_0_0_var(--button-depth),0_0_0_2px_rgb(255_255_255_/_0.5),0_0_0_rgb(0_0_0_/_0),0_0_0_rgb(0_0_0_/_0)]",
    "disabled:pointer-events-none disabled:translate-y-0 disabled:cursor-not-allowed disabled:opacity-50",
    "[&_[data-slot=icon]]:shrink-0 [&_[data-slot=icon]>svg]:size-full",
  ],
  {
    variants: {
      variant: {
        primary:
          "[--button-bg:var(--primary)] [--button-border:color-mix(in_srgb,var(--primary)_70%,black)] [--button-depth:color-mix(in_srgb,var(--primary)_70%,black)] [--button-fg:var(--primary-foreground)] dark:[--button-border:color-mix(in_srgb,var(--primary)_52%,black)] dark:[--button-depth:color-mix(in_srgb,var(--primary)_52%,black)]",
        accent:
          "[--button-bg:var(--accent-color)] [--button-border:color-mix(in_srgb,var(--accent-color)_70%,black)] [--button-depth:color-mix(in_srgb,var(--accent-color)_70%,black)] [--button-fg:var(--accent-foreground)] dark:[--button-border:color-mix(in_srgb,var(--accent-color)_52%,black)] dark:[--button-depth:color-mix(in_srgb,var(--accent-color)_52%,black)]",
        secondary:
          "[--button-bg:var(--muted)] [--button-border:color-mix(in_srgb,var(--muted)_72%,black)] [--button-depth:color-mix(in_srgb,var(--muted)_72%,black)] [--button-fg:var(--foreground)] dark:[--button-border:color-mix(in_srgb,var(--muted)_88%,white)] dark:[--button-depth:color-mix(in_srgb,var(--muted)_82%,white)]",
        ghost:
          "shadow-none [text-shadow:none] active:shadow-none [--button-bg:transparent] [--button-border:transparent] [--button-depth:transparent] [--button-fg:var(--foreground)] hover:[--button-bg:var(--muted)]",
      },
      size: {
        sm: "h-8 gap-1.5 text-xs [&_[data-slot=icon]]:size-4",
        md: "h-10 gap-2 text-sm [&_[data-slot=icon]]:size-5",
        lg: "h-12 gap-2.5 px-5 text-base [&_[data-slot=icon]]:size-6",
        "icon-sm": "size-8 min-w-0 p-0 [&_[data-slot=icon]]:size-4",
        "icon-md": "size-10 min-w-0 p-0 [&_[data-slot=icon]]:size-5",
        "icon-lg": "size-12 min-w-0 p-0 [&_[data-slot=icon]]:size-6",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "md",
    },
  },
);

const {
  href,
  type = "button",
  class: className,
  variant,
  size,
  disabled = false,
  target,
  rel,
  ariaLabel,
  ...attrs
} = Astro.props;

const classes = cn(buttonVariants({ variant, size }), className);
const safeRel = target === "_blank" && !rel ? "noreferrer" : rel;
const hasIcon = Astro.slots.has("icon");
---

{
  href ? (
    <a
      class={classes}
      href={disabled ? undefined : href}
      target={target}
      rel={safeRel}
      aria-label={ariaLabel}
      aria-disabled={disabled ? "true" : undefined}
      {...attrs}
    >
      {hasIcon && (
        <span data-slot="icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
      <slot />
    </a>
  ) : (
    <button
      class={classes}
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
      {...attrs}
    >
      {hasIcon && (
        <span data-slot="icon" aria-hidden="true">
          <slot name="icon" />
        </span>
      )}
      <slot />
    </button>
  )
}
