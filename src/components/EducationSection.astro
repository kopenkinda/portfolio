---
import { ArrowUpRight } from "@lucide/astro";
import { CONFIG, USER } from "../consts";
import Button from "./Button.astro";

const education = USER.education.entries;

const yearFormatter = new Intl.DateTimeFormat("en", { year: "numeric" });

const formatYear = (date: Date) => yearFormatter.format(date);

const formatRange = ({ startDate, endDate }: (typeof education)[number]) =>
  endDate
    ? `${formatYear(startDate)} - ${formatYear(endDate)}`
    : formatYear(startDate);

const getTypeLabel = (type: (typeof education)[number]["type"]) =>
  type === "certifications" ? "certification" : type;

const sectionClasses = CONFIG.game.enabled
  ? "border-y border-border/70 bg-muted/35"
  : "border-b border-border/70 bg-background";
---

<section id="education" class:list={["py-16 md:py-24", sectionClasses]}>
  <div class="container mx-auto px-4 sm:px-6">
    <div class="mb-8 max-w-3xl">
      <h2 class="font-headline text-3xl font-bold dark:font-normal">
        Education
      </h2>
    </div>

    <div class="grid gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <div
        class="hidden border border-border bg-card p-5 shadow-[6px_6px_0_var(--border)] lg:block"
      >
        <p class="font-headline text-sm font-black uppercase dark:font-bold">
          Education index
        </p>
        <ol class="mt-6 space-y-4">
          {
            education.map((entry, index) => (
              <li class="border-l-2 border-accent pl-3">
                <p class="font-headline text-xs font-black text-accent uppercase dark:font-bold">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <p class="mt-1 text-sm leading-tight font-bold">
                  {entry.title}
                </p>
                <p class="mt-1 text-xs text-muted-foreground">
                  {formatRange(entry)}
                </p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {
          education.map((entry) => (
            <article class="flex min-h-52 flex-col border border-border bg-card p-5 shadow-[6px_6px_0_var(--border)]">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <span class="border border-accent bg-background px-2 py-1 font-headline text-xs font-black text-accent uppercase dark:font-bold">
                  {getTypeLabel(entry.type)}
                </span>
                {entry.href && (
                  <Button
                    href={entry.href}
                    target="_blank"
                    variant="secondary"
                    size="sm"
                    class="w-fit font-headline font-black uppercase dark:font-bold"
                  >
                    {entry.actionLabel ?? "Open"}
                    <ArrowUpRight slot="icon" />
                  </Button>
                )}
              </div>

              <h3 class="mt-6 text-xl font-bold text-card-foreground">
                {entry.title}
              </h3>

              <p class="mt-auto pt-8 text-sm text-muted-foreground">
                {entry.organization} /{" "}
                <time datetime={entry.startDate.toISOString()}>
                  {formatRange(entry)}
                </time>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
