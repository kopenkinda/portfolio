---
import { CONFIG } from "../consts";
import Autobattler from "./games/Autobattler.astro";
---

<section id="games" class="bg-background py-14 md:py-18">
  <div class="container mx-auto px-4 sm:px-6">
    <div
      class="grid gap-8 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:items-start"
    >
      <div>
        <h2 class="font-headline text-3xl font-bold dark:font-normal">
          {CONFIG.game.title}
        </h2>
        <p
          class="mt-3 max-w-[48ch] text-sm leading-relaxed text-muted-foreground"
        >
          {CONFIG.game.description}
        </p>
      </div>

      {CONFIG.game.game === "autobattler" && <Autobattler />}
    </div>
  </div>
</section>
