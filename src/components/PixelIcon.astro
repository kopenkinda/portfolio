---
type IconName = "file" | "github" | "telegram" | "mail" | "linkedin";

type Props = {
  name: IconName;
};

const { name } = Astro.props;
---

{
  name === "file" && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M6 4H4v16h2zm10-2H6v2h10zm4 4h-2v14h2zm-2 14H6v2h12zM16 4h2v2h-2zm-4 0h2v6h-2z" />
      <path d="M12 8h6v2h-6z" />
    </svg>
  )
}

{
  name === "github" && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
