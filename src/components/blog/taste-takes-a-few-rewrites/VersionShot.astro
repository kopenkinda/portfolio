---
// A portfolio screenshot figure with a caption and click-to-zoom through Layout's ImageZoom.
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const width = Math.min(src.width, 2400);
const large = await getImage({ src, width });
---

<figure class="not-prose my-8 flex flex-col gap-2">
  <Image
    src={src}
    alt={alt}
    widths={[576, 1152]}
    sizes="(min-width: 36rem) 36rem, 100vw"
    data-zoom=""
    data-zoom-src={large.src}
    data-zoom-width={width}
    class="w-full rounded-sm border border-ash/15"
  />
  {caption && <figcaption class="text-sm text-ash">{caption}</figcaption>}
</figure>
