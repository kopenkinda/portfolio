---
import { X } from "@lucide/astro";
import type { Arc, Marker } from "cobe";
import globePreviewDark from "../assets/globe/globe-preview-dark.webp";
import globePreviewLight from "../assets/globe/globe-preview-light.webp";
import { USER } from "../consts";

const globe = USER.globe;
const name = USER.name;

const toAnchorId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const locations = globe.locations.map((location, idx) => ({
  ...location,
  description: location.description || "",
  markerId: toAnchorId(location.id ?? location.label),
  rotate: idx % 2 === 0 ? "-3deg" : "3deg",
}));

const markers: Marker[] = locations.map(({ lat, lng, markerId }) => ({
  location: [lat, lng] as [number, number],
  size: 0.045,
  id: markerId,
}));

const connections = globe.connections.map((connection) => ({
  ...connection,
  arcId: toAnchorId(connection.id),
}));

const arcs: Arc[] = connections.map(({ from, to, arcId, color }) => ({
  from: [from.lat, from.lng] as [number, number],
  to: [to.lat, to.lng] as [number, number],
  id: arcId,
  color,
}));

const rotation = { phi: globe.intial.phi, theta: globe.intial.theta };
const globeData = JSON.stringify({ arcs, markers, rotation });
---

<progressive-globe
  class="progressive-globe"
  data-progressive-globe
  data-globe={globeData}
  aria-label={`Globe with ${name}'s highlights`}
>
  <div class="globe-stage" data-globe-stage>
    <img
      class="globe-fallback globe-fallback-light"
      src={globePreviewLight.src}
      alt={globe.intial.srDescription}
      width="640"
      height="640"
      loading="eager"
      decoding="async"
    />
    <img
      class="globe-fallback globe-fallback-dark"
      src={globePreviewDark.src}
      alt={globe.intial.srDescription}
      width="640"
      height="640"
      loading="eager"
      decoding="async"
    />
    <canvas class="globe-canvas" aria-hidden="true"></canvas>
    {
      locations.map(({ label, image, markerId, rotate }) => (
        <button
          class="globe-polaroid"
          type="button"
          data-globe-polaroid
          data-location-id={markerId}
          style={`position-anchor: --cobe-${markerId}; --cobe-visible: var(--cobe-visible-${markerId}, 0); --polaroid-rotate: ${rotate};`}
          aria-label={`Open ${label}`}
        >
          {image && (
            <img src={image.src} alt="" loading="eager" decoding="async" />
          )}
          <span>{label}</span>
        </button>
      ))
    }
    {
      connections.map(
        ({ label, arcId }) =>
          label && (
            <span
              class="globe-arc-label"
              style={`position-anchor: --cobe-arc-${arcId}; --cobe-visible: var(--cobe-visible-arc-${arcId}, 0);`}
              aria-hidden="true"
            >
              {label}
            </span>
          ),
      )
    }
    <div class="globe-detail" data-globe-detail hidden>
      {
        locations.map(({ label, description, image, markerId, rotate }) => (
          <article
            class="globe-detail-card"
            data-globe-detail-card
            data-location-id={markerId}
            style={`--polaroid-rotate: ${rotate};`}
            hidden
          >
            <button
              class="globe-detail-close z-10"
              type="button"
              data-globe-detail-close
              aria-label="Close"
            >
              <X class="size-4" aria-hidden="true" />
            </button>
            {image && (
              <img src={image.src} alt="" loading="eager" decoding="async" />
            )}
            <h3>{label}</h3>
            {description && <p>{description}</p>}
          </article>
        ))
      }
    </div>
  </div>
</progressive-globe>

<style>
  .progressive-globe {
    width: min(100%, 36rem);
    aspect-ratio: 1;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }

  .progressive-globe.is-dragging {
    cursor: grabbing;
  }

  .globe-stage {
    position: relative;
    width: 100%;
    height: 100%;
    isolation: isolate;
  }

  .globe-stage::before {
    position: absolute;
    inset: 12%;
    z-index: -1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-color) 10%, transparent);
    filter: blur(48px);
    opacity: 0.55;
    content: "";
  }

  .globe-fallback,
  .globe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .globe-fallback {
    object-fit: contain;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .globe-fallback-light {
    opacity: 0.9;
  }

  :global(.dark) .globe-fallback-light {
    opacity: 0;
  }

  :global(.dark) .globe-fallback-dark {
    opacity: 0.9;
  }

  .globe-canvas {
    opacity: 0;
    transition: opacity 360ms ease;
  }

  .progressive-globe.is-loaded .globe-fallback {
    opacity: 0;
  }

  .progressive-globe.is-loaded .globe-canvas {
    opacity: 1;
  }

  .globe-polaroid {
    appearance: none;
    position: absolute;
    top: anchor(center);
    left: anchor(center);
    z-index: 2;
    width: clamp(4.9rem, 8.8vw, 6rem);
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 2px;
    background: rgb(255 255 255);
    box-shadow:
      0 7px 18px rgb(0 0 0 / 0.13),
      0 1px 2px rgb(0 0 0 / 0.12);
    padding: 0.34rem 0.34rem 0.44rem;
    color: rgb(39 39 42);
    cursor: pointer;
    font-family: var(--font-doto);
    font-size: clamp(0.52rem, 0.9vw, 0.62rem);
    font-weight: 800;
    font-variation-settings: "ROND" 100;
    line-height: 1;
    opacity: 0;
    rotate: var(--polaroid-rotate, -3deg);
    translate: -50% -88%;
    white-space: nowrap;
    transition:
      opacity 220ms ease,
      filter 220ms ease,
      transform 220ms ease;
  }

  .globe-polaroid:hover {
    transform: translateY(-0.18rem) scale(1.04);
  }

  .globe-polaroid:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 3px;
  }

  .globe-polaroid::after {
    position: absolute;
    top: calc(100% + 0.2rem);
    left: 50%;
    width: 0.45rem;
    height: 0.45rem;
    translate: -50% 0;
    border-radius: 999px;
    background: var(--accent-color);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--background) 76%, transparent);
    content: "";
  }

  .globe-polaroid img {
    width: 100%;
    aspect-ratio: 1.1;
    display: block;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
  }

  .globe-polaroid span {
    display: block;
    overflow: hidden;
    margin-top: 0.32rem;
    text-align: center;
    text-overflow: ellipsis;
  }

  .progressive-globe.is-loaded .globe-polaroid {
    opacity: var(--cobe-visible, 0);
    filter: blur(calc((1 - var(--cobe-visible, 1)) * 5px));
  }

  .globe-arc-label {
    position: absolute;
    bottom: anchor(top);
    left: anchor(center);
    z-index: 2;
    margin-bottom: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 22%, transparent);
    border-radius: 3px;
    background: rgb(255 255 255 / 0.92);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--background) 78%, transparent),
      0 0 18px color-mix(in srgb, var(--accent-color) 18%, transparent);
    padding: 0.2rem 0.46rem;
    color: rgb(39 39 42);
    font-family: var(--font-doto);
    font-size: clamp(0.7rem, 1.25vw, 0.84rem);
    font-weight: 800;
    font-variation-settings: "ROND" 100;
    line-height: 1;
    opacity: 0;
    translate: -50% 0;
    white-space: nowrap;
    transition:
      opacity 220ms ease,
      filter 220ms ease;
  }

  .progressive-globe.is-loaded .globe-arc-label {
    opacity: var(--cobe-visible, 0);
    filter: blur(calc((1 - var(--cobe-visible, 1)) * 5px));
  }

  .globe-detail {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 5vw, 2rem);
    background: color-mix(in srgb, var(--background) 24%, transparent);
    backdrop-filter: blur(2px);
  }

  .globe-detail[hidden],
  .globe-detail-card[hidden] {
    display: none;
  }

  .globe-detail-card {
    position: relative;
    width: min(72%, 18rem);
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 2px;
    background: rgb(255 255 255);
    box-shadow:
      0 22px 54px rgb(0 0 0 / 0.28),
      0 2px 6px rgb(0 0 0 / 0.16);
    padding: 0.62rem 0.62rem 1rem;
    color: rgb(39 39 42);
    rotate: var(--polaroid-rotate, -2deg);
    animation: globe-detail-in 180ms ease-out;
  }

  .globe-detail-card img {
    width: 100%;
    aspect-ratio: 1.08;
    display: block;
    object-fit: cover;
    filter: saturate(0.95) contrast(1.04);
  }

  .globe-detail-card h3,
  .globe-detail-card p {
    margin: 0;
  }

  .globe-detail-card h3 {
    margin-top: 0.58rem;
    font-family: var(--font-doto);
    font-size: clamp(0.9rem, 2.2vw, 1.2rem);
    font-weight: 900;
    font-variation-settings: "ROND" 100;
    line-height: 1;
    text-align: center;
  }

  .globe-detail-card p {
    margin-top: 0.54rem;
    font-size: clamp(0.75rem, 1.5vw, 0.9rem);
    line-height: 1.38;
  }

  .globe-detail-close {
    appearance: none;
    position: absolute;
    top: -0.9rem;
    right: -0.9rem;
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    color: rgb(39 39 42);
    cursor: pointer;
  }

  .globe-detail-close:focus-visible {
    outline: 2px solid var(--accent-color);
    outline-offset: 2px;
  }

  @keyframes globe-detail-in {
    from {
      opacity: 0;
      transform: translateY(0.7rem) scale(0.96);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  import createGlobe, { type COBEOptions, type Globe } from "cobe";

  const getTheme = () => document.documentElement.dataset.theme || "light";

  const rgb = (
    red: number,
    green: number,
    blue: number,
  ): [number, number, number] => [red, green, blue];

  const getPalette = (): Pick<
    COBEOptions,
    "baseColor" | "dark" | "glowColor" | "mapBrightness" | "markerColor"
  > => {
    const dark = getTheme() === "dark";

    return {
      dark: dark ? 1 : 0,
      baseColor: dark ? rgb(0.13, 0.13, 0.12) : rgb(1, 1, 1),
      markerColor: dark ? rgb(0.18, 1, 0.9) : rgb(0, 0.48, 0.43),
      glowColor: dark ? rgb(0.05, 0.86, 0.78) : rgb(0.96, 0.97, 0.98),
      mapBrightness: dark ? 2.8 : 1.45,
    };
  };

  type GlobeData = Pick<COBEOptions, "arcs" | "markers"> & {
    rotation: { phi: number; theta: number };
  };

  class ProgressiveGlobe extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.dataset.mounted) return;

      const canvas = this.querySelector("canvas");
      const stage = this.querySelector("[data-globe-stage]");
      const detail = this.querySelector("[data-globe-detail]");

      if (
        !(canvas instanceof HTMLCanvasElement) ||
        !(stage instanceof HTMLElement) ||
        !(detail instanceof HTMLElement)
      ) {
        return;
      }

      const data = this.dataset.globe;
      if (!data) return;

      const { arcs, markers, rotation } = JSON.parse(data) as GlobeData;

      this.dataset.mounted = "true";

      const probe = document.createElement("canvas");
      if (!probe.getContext("webgl2") && !probe.getContext("webgl")) {
        return;
      }

      let globe: Globe | undefined;
      let frame = 0;
      let size = 0;
      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let dragStartPhi = rotation.phi;
      let dragStartTheta = rotation.theta;
      const polaroids = Array.from(
        this.querySelectorAll("[data-globe-polaroid]"),
      );
      const detailCards = Array.from(
        this.querySelectorAll("[data-globe-detail-card]"),
      );
      const detailCloseButtons = Array.from(
        this.querySelectorAll("[data-globe-detail-close]"),
      );

      const closeDetail = () => {
        detail.hidden = true;
        detailCards.forEach((card) => {
          if (card instanceof HTMLElement) card.hidden = true;
        });
      };

      const openDetail = (id: string) => {
        detail.hidden = false;
        detailCards.forEach((card) => {
          if (card instanceof HTMLElement) {
            card.hidden = card.dataset.locationId !== id;
          }
        });
      };

      const options = (): COBEOptions => ({
        width: size,
        height: size,
        devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
        phi: rotation.phi,
        theta: rotation.theta,
        diffuse: 1.2,
        mapSamples: 14000,
        mapBaseBrightness: 0,
        markerElevation: 0.01,
        arcWidth: 0.9,
        arcHeight: 0.28,
        scale: 1,
        opacity: 1,
        markers,
        arcs,
        ...getPalette(),
      });

      const resize = () => {
        const nextSize = Math.max(280, Math.round(stage.clientWidth));
        if (nextSize === size) return;

        size = nextSize;

        if (globe) {
          globe.update({
            width: size,
            height: size,
            devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
          });
        }
      };

      const render = () => {
        if (!globe) return;

        globe.update({
          phi: rotation.phi,
          theta: rotation.theta,
        });

        frame = window.requestAnimationFrame(render);
      };

      const mount = () => {
        resize();

        globe = createGlobe(canvas, options());
        frame = window.requestAnimationFrame(render);

        window.setTimeout(() => {
          this.classList.add("is-loaded");
        }, 180);
      };

      const observer =
        "ResizeObserver" in window ? new ResizeObserver(resize) : undefined;
      observer?.observe(stage);
      window.addEventListener("resize", resize, { passive: true });

      const clampTheta = (value: number) =>
        Math.max(-Math.PI / 2, Math.min(Math.PI / 2, value));

      const onPointerDown = (event: PointerEvent) => {
        if (
          event.target instanceof Element &&
          event.target.closest("[data-globe-polaroid], [data-globe-detail]")
        ) {
          return;
        }

        isDragging = true;
        this.classList.add("is-dragging");
        this.setPointerCapture(event.pointerId);
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        dragStartPhi = rotation.phi;
        dragStartTheta = rotation.theta;
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!isDragging) return;

        const deltaX = event.clientX - dragStartX;
        const deltaY = event.clientY - dragStartY;

        rotation.phi = dragStartPhi + deltaX / 220;
        rotation.theta = clampTheta(dragStartTheta + deltaY / 280);
      };

      const onPointerUp = (event: PointerEvent) => {
        isDragging = false;
        this.classList.remove("is-dragging");

        if (this.hasPointerCapture(event.pointerId)) {
          this.releasePointerCapture(event.pointerId);
        }
      };

      this.addEventListener("pointerdown", onPointerDown);
      this.addEventListener("pointermove", onPointerMove);
      this.addEventListener("pointerup", onPointerUp);
      this.addEventListener("pointercancel", onPointerUp);

      const onPolaroidClick = (event: Event) => {
        const target = event.currentTarget;
        if (target instanceof HTMLElement && target.dataset.locationId) {
          openDetail(target.dataset.locationId);
        }
      };

      const onDetailClick = (event: Event) => {
        if (event.target === detail) closeDetail();
      };

      const onKeyDown = (event: KeyboardEvent) => {
        if (event.key === "Escape") closeDetail();
      };

      polaroids.forEach((polaroid) => {
        polaroid.addEventListener("click", onPolaroidClick);
      });
      detailCloseButtons.forEach((button) => {
        button.addEventListener("click", closeDetail);
      });
      detail.addEventListener("click", onDetailClick);
      window.addEventListener("keydown", onKeyDown);

      const themeObserver = new MutationObserver(() => {
        globe?.update(getPalette());
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class", "data-theme"],
      });

      this.cleanup = () => {
        window.cancelAnimationFrame(frame);
        observer?.disconnect();
        window.removeEventListener("resize", resize);
        this.removeEventListener("pointerdown", onPointerDown);
        this.removeEventListener("pointermove", onPointerMove);
        this.removeEventListener("pointerup", onPointerUp);
        this.removeEventListener("pointercancel", onPointerUp);
        polaroids.forEach((polaroid) => {
          polaroid.removeEventListener("click", onPolaroidClick);
        });
        detailCloseButtons.forEach((button) => {
          button.removeEventListener("click", closeDetail);
        });
        detail.removeEventListener("click", onDetailClick);
        window.removeEventListener("keydown", onKeyDown);
        themeObserver.disconnect();
        globe?.destroy();
        delete this.dataset.mounted;
      };

      mount();
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get("progressive-globe")) {
    customElements.define("progressive-globe", ProgressiveGlobe);
  }
</script>
