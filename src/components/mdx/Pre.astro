---
const { class: className, ...attrs } = Astro.props;
const language =
  Astro.props["data-language"] ??
  (typeof className === "string"
    ? className.match(/language-([^\s]+)/)?.[1]
    : undefined) ??
  "text";
---

<div class="my-6 overflow-hidden border border-border bg-muted">
  <div
    class="flex items-center gap-2 border-b border-border bg-background/60 px-3 py-2"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 border border-muted-foreground/60"></span>
      <span class="size-2.5 border border-muted-foreground/60"></span>
      <span class="size-2.5 border border-muted-foreground/60"></span>
    </span>
    <span
      class="ml-1 text-[0.7rem] tracking-[0.2em] text-muted-foreground uppercase"
    >
      {language === "text" ? "sh" : language}
    </span>
  </div>
  <pre
    {...attrs}
    class:list={[
      className,
      "!my-0 overflow-x-auto !border-0 !bg-transparent px-4 py-3 text-[0.8125rem] leading-relaxed",
    ]}><slot /></pre>
</div>
