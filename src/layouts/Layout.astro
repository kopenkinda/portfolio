---
import {
  ArrowLeft01Icon,
  Cancel01Icon,
  GithubIcon,
  Moon02Icon,
  Sun03Icon,
  VolumeHighIcon,
  VolumeMute02Icon,
} from "@hugeicons/core-free-icons";
import { Font } from "astro:assets";
import Icon from "../components/Icon.astro";
import HourglassTint from "../components/hourglass/HourglassTint.astro";
import ImageZoom from "../components/ImageZoom.astro";
import "../styles/global.css";

interface Props {
  /** Page name; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** The page one level up. Subpages get this link instead of a menu; only the home page has one. */
  back?: { label: string; href: string };
  /** Background texture; a wall theme with its own texture overrides it. */
  texture?: "dots" | "bricks";
  /** A post's publish date. Link previews and search then treat the page as an article. */
  published?: Date;
}

const name = "Dmitrii Kopenkin";
const email = "hi@kopenkin.tech";
const {
  title,
  description = `${name}, product engineer in Andorra. Eight years building software for supermarkets, hospitals and engineering teams. Co-founder of Salut!, open to a remote role.`,
  back,
  texture = "dots",
  published,
} = Astro.props;

// Search and link previews need absolute addresses. Every page has a share card at its own path
// under /og/ (src/pages/og/[...page].png.ts).
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`/og/${Astro.url.pathname.replace(/^\/|\/$/g, "") || "index"}.png`, Astro.site);

const links = [
  { label: "Email", href: `mailto:${email}` },
  { label: "GitHub", href: "https://github.com/kopenkinda" },
  { label: "LinkedIn", href: "https://linkedin.com/in/dmitrii-kopenkin" },
  { label: "Telegram", href: "https://t.me/leroifrancais" },
];

const link = "underline decoration-accent underline-offset-4 transition-colors hover:decoration-paper";
const control = "h-8 cursor-pointer items-center justify-center gap-1.5 rounded-sm text-ash transition-colors hover:text-paper";
---

<html lang="en" data-texture={texture} data-graphic="map">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} | ${name}` : `${name} | Product engineer in Andorra`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={name} href="/rss.xml" />
    <!-- Umami page views, production only: the dev server never loads it, and data-domains skips a
         production build previewed locally. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="cf8f1353-5b5b-46ff-86e7-cac4dc4204ce"
          data-domains="kopenkin.tech"
        />
      )
    }
    <meta property="og:type" content={published ? "article" : "website"} />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title ?? name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`"${title ?? name}" over a dotted mountain valley at night`} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <!-- Structured data: who the site is about on the home page, and what a post is on a post page. -->
    {
      !title && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            name,
            url: Astro.site,
            jobTitle: "Product engineer",
            description: "Product engineer in Andorra and co-founder of Salut!, a retail ERP for independent supermarkets.",
            email: `mailto:${email}`,
            sameAs: links.filter((link) => link.href.startsWith("https")).map((link) => link.href),
          })}
        />
      )
    }
    {
      published && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            headline: title,
            description,
            datePublished: published.toISOString(),
            image,
            url,
            author: { "@type": "Person", name, url: Astro.site },
          })}
        />
      )
    }
    <Font cssVariable="--font-mona-sans" preload />
    <Font cssVariable="--font-literata" preload />
    <script is:inline>
      // Re-apply the saved mode, wall theme and sound setting before the page paints
      // (see src/scripts/theme.ts and src/scripts/sounds.ts).
      try {
        const root = document.documentElement;
        if (localStorage.getItem("mode") === "light") root.dataset.mode = "light";
        // Sound shows as on once an interaction in this tab has unlocked audio, unless turned off.
        if (localStorage.getItem("sound") !== "off" && sessionStorage.getItem("sound-unlocked")) {
          root.dataset.sound = "on";
        }
        // The site's previous version saved its own "dark" or "light" under the same key, which isn't
        // JSON. Drop anything that isn't a wall theme, or the parse error skips the rest of this script.
        let theme = null;
        try {
          theme = JSON.parse(localStorage.getItem("theme"));
        } catch {}
        if (theme && !theme.colors) theme = null;
        if (!theme) localStorage.removeItem("theme");
        if (theme) {
          for (const [token, value] of Object.entries(theme.colors)) {
            root.style.setProperty(`--color-${token}`, value);
          }
          if (theme.texture) root.style.setProperty("--texture", `var(--texture-${theme.texture})`);
          root.toggleAttribute("data-themed", true);
        }
        // A fresh arrival (typed in, a link from elsewhere, or a reload) rather than a page switch
        // within the site, which already has its own transition. Pages can animate in on this.
        const from = document.referrer ? new URL(document.referrer).origin : "";
        const reload = performance.getEntriesByType("navigation")[0]?.type === "reload";
        if (from !== location.origin || reload) root.dataset.arrival = "fresh";
        root.dataset.graphic = theme?.graphic ?? (root.dataset.mode === "light" ? "map" : "dots");
        const ink = theme ? theme.colors.ink : root.dataset.mode === "light" ? "#f2f1ed" : "#0a0a0a";
        document.querySelector('meta[name="theme-color"]').setAttribute("content", ink);
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh">
    <div class="mx-auto max-w-xl px-4 pt-6 pb-16">
      <!-- Site controls: colours and sound. While a wall theme is on, its name replaces the mode
           switch, and pressing it goes back to the mode. Icons show the current state. Every icon
           sits 0.1em low, on the text's optical centre, so icons and the theme name share a line. -->
      <site-controls class="-mr-2 flex justify-end gap-1 text-sm">
        <button type="button" data-control="mode" class={`${control} inline-flex w-8 in-data-themed:hidden`} aria-label="Light mode" title="Light mode">
          <Icon icon={Moon02Icon} class="size-4 translate-y-[0.1em] in-data-[mode=light]:hidden" />
          <Icon icon={Sun03Icon} class="hidden size-4 translate-y-[0.1em] in-data-[mode=light]:block" />
        </button>
        <button type="button" data-control="reset" class={`${control} hidden px-2 in-data-themed:inline-flex`} title="Reset theme">
          <span id="theme-name"></span>
          <Icon icon={Cancel01Icon} class="size-3.5 translate-y-[0.1em]" />
        </button>
        <script is:inline>
          try {
            const name = JSON.parse(localStorage.getItem("theme"))?.name;
            if (name) document.getElementById("theme-name").textContent = name;
          } catch {}
        </script>
        <button type="button" data-control="sound" class={`${control} inline-flex w-8`} aria-label="Sound" title="Sound">
          <Icon icon={VolumeMute02Icon} class="size-4 translate-y-[0.1em] in-data-[sound=on]:hidden" />
          <Icon icon={VolumeHighIcon} class="hidden size-4 translate-y-[0.1em] in-data-[sound=on]:block" />
        </button>
      </site-controls>

      <div class="mt-10 sm:mt-18">
        {
          back && (
            <a
              href={back.href}
              class="group mb-5 -ml-1 inline-flex items-center gap-0.5 text-sm text-ash"
            >
              <Icon icon={ArrowLeft01Icon} class="size-4 translate-y-[0.1em]" />
              <span class="underline decoration-accent underline-offset-4 transition-colors group-hover:decoration-paper">
                {back.label}
              </span>
            </a>
          )
        }
        <main>
          <slot />
        </main>
      </div>

      <footer class="mt-24 text-sm text-ash">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <ul class="flex gap-5">
            {
              links.map((item) => (
                <li>
                  <a href={item.href} class={link}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <span class="inline-flex items-center gap-3">
            © 2026 {name}
            <a
              href="https://github.com/kopenkinda/portfolio"
              class="transition-colors hover:text-paper"
              aria-label="Source on GitHub"
              title="Source on GitHub"
            >
              <Icon icon={GithubIcon} class="size-4" />
            </a>
          </span>
        </div>
      </footer>
    </div>

    <script>
      import { isSoundOn, setSound } from "../scripts/sounds";
      import { getMode, getTheme, setMode, setTheme } from "../scripts/theme";

      class SiteControls extends HTMLElement {
        connectedCallback() {
          const mode = this.querySelector("[data-control=mode]")!;
          const reset = this.querySelector("[data-control=reset]")!;
          const sound = this.querySelector("[data-control=sound]")!;
          const name = this.querySelector("#theme-name")!;

          const render = () => {
            mode.setAttribute("aria-pressed", String(getMode() === "light"));
            sound.setAttribute("aria-pressed", String(isSoundOn()));
            const theme = getTheme();
            name.textContent = theme?.name ?? "";
            reset.setAttribute("aria-label", theme ? `${theme.name} theme. Reset` : "Reset theme");
          };

          mode.addEventListener("click", () => setMode(getMode() === "light" ? "dark" : "light"));
          reset.addEventListener("click", () => setTheme(null));
          sound.addEventListener("click", () => setSound(!isSoundOn()));
          document.addEventListener("themechange", render);
          document.addEventListener("soundchange", render);
          render();
        }
      }

      if (!customElements.get("site-controls")) customElements.define("site-controls", SiteControls);
    </script>
    <ImageZoom />
    <HourglassTint />
  </body>
</html>
