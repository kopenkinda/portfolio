---
import { Font } from "astro:assets";
import "../styles/global.css";

// Placeholder content. Replace with real entries.
const name = "Dmitrii Kopenkin";
const email = "hi@kopenkin.tech";

const work = [
  { year: "2026", text: "CTO at Salut Mercado, a retail ERP for independent supermarkets" },
  { year: "2024", text: "Built a browser-based CAD viewer used by 7,500+ companies" },
  { year: "2022", text: "Put ML models into surgical triage across 100+ hospitals" },
  { year: "2017", text: "Shipped prototypes, most went nowhere, a few did" },
];

const links = [
  { label: "Email", href: `mailto:${email}` },
  { label: "GitHub", href: "https://github.com/kopenkinda" },
  { label: "LinkedIn", href: "https://linkedin.com/in/dmitrii-kopenkin" },
  { label: "Telegram", href: "https://t.me/leroifrancais" },
];

const link = "underline decoration-ash/40 underline-offset-4 transition-colors hover:decoration-paper";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{name}</title>
    <meta name="description" content="Dmitrii Kopenkin, full-stack product engineer in Andorra." />
    <Font cssVariable="--font-encode-sans" preload />
    <Font cssVariable="--font-outfit" preload />
  </head>
  <body class="min-h-dvh">
    <main class="mx-auto max-w-xl px-4 pt-24 pb-16 sm:pt-32">
      <h1 class="font-display text-3xl font-medium tracking-tight">{name}</h1>
      <p class="mt-2 text-ash">
        Full-stack product engineer in Andorra. <a href={`mailto:${email}`} class={link}>Send me an email</a>
      </p>

      <div class="mt-12 space-y-5 leading-relaxed">
        <p>
          I build complete products, from the database schema to the feature in a customer's hands. Most
          of my work is in TypeScript, React, Node, Python, Go and Postgres.
        </p>
        <p>
          Right now I'm CTO at <a href="https://salutmercado.com" class={link}>Salut Mercado</a>, where
          we're shipping an ERP to independent supermarkets in Barcelona.
        </p>
      </div>

      <h2 class="mt-14 font-display text-lg font-medium">Work</h2>
      <ul class="mt-4 space-y-3 leading-relaxed">
        {
          work.map((item) => (
            <li class="flex gap-6">
              <span class="w-10 shrink-0 text-ash tabular-nums">{item.year}</span>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>

      <footer class="mt-24 flex flex-wrap items-baseline justify-between gap-4 text-sm text-ash">
        <ul class="flex gap-5">
          {
            links.map((item) => (
              <li>
                <a href={item.href} class={link}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <span>© 2026 {name}</span>
      </footer>
    </main>
  </body>
</html>
