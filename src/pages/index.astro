---
import BaseHead from "../components/BaseHead.astro";
import BasePage from "../components/BasePage.astro";
import { SITE_DESCRIPTION, SITE_TITLE, USER } from "../consts";
---

<BasePage>
  <Fragment slot="head">
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </Fragment>
  <main>
    <section
      id="about-me"
      class="container mx-auto p-4 transition-all duration-300"
    >
      <h2 class="mt-36 font-headline text-4xl">
        Hi, my name is <span class="inline-block font-bold text-accent"
          >{USER.name}</span
        >
      </h2>
      <span class="mt-4 inline-block max-w-[60ch] leading-relaxed text-balance"
        >{USER.headline}</span
      >
    </section>
  </main>
</BasePage>
