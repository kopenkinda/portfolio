---
import AndorraScene from "../components/andorra/AndorraScene.astro";
import DotsScene from "../components/dots/DotsScene.astro";
import HourglassScene from "../components/hourglass/HourglassScene.astro";
import OpenSource from "../components/open-source/OpenSource.astro";
import Layout from "../layouts/Layout.astro";

const work = [
  {
    year: "2026",
    text: "Shipped the Salut! POS, inventory and barcode onboarding across 6,000+ products. Stores ran 48,500+ transactions and €280k in sales through it between May and September.",
  },
  {
    year: "2025",
    text: "At Move Work Forward, built browser 2D/3D CAD viewers for Confluence and Jira with revision tracking and support for 70+ CAD formats.",
  },
  {
    year: "2024",
    text: "Hooked a real-time currency arbitrage and position-tracking app straight into the QUIK trading terminal.",
  },
  {
    year: "2023",
    text: "Worked on Orthense at Digikare, an orthopedic platform in 100+ hospitals. Automated implant lookup from surgical photos with a 90% confidence bar for human review, which contributed to a 20% efficiency gain.",
  },
  {
    year: "2021",
    text: "Led five developers at Toulouse Ynov Campus on automated grading and campus platforms that cut manual admin work in half, and mentored 150+ students while earning my Master's.",
  },
  {
    year: "2018",
    text: "Linked an online storefront to the IIKO POS for AQUAService so orders went directly to the restaurant. Online orders rose 20% and bounce rate fell 40%.",
  },
];

const nav = [
  { label: "Blog", href: "/blog/" },
  { label: "Wall", href: "/wall/" },
];

const link = "underline decoration-accent underline-offset-4 transition-colors hover:decoration-paper";
---

<Layout>
  <!-- One graphic shows, picked by the colours: the painted map, the valley in dots, or the
       Hourglass theme's glass. -->
  <AndorraScene />
  <DotsScene />
  <HourglassScene />
  <h1 class="appear mt-10 font-display text-3xl font-medium tracking-tight" style="--order: 0">Dmitrii Kopenkin</h1>
  <nav class="appear mt-3 text-sm text-ash" style="--order: 1">
    <ul class="flex gap-5">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class={link}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-14 space-y-5 leading-relaxed">
    <p class="appear" style="--order: 2">
      I'm a product engineer in Andorra. Over the past eight years I've built software for
      supermarkets, hospitals, engineering teams and schools. I'd rather own a product than work
      off tickets. I like sitting with the people who use what I build and fixing whatever gets in
      their way.
    </p>
    <p class="appear" style="--order: 3">
      I co-founded <a href="https://salutmercado.com" class={link}>Salut!</a>, a retail ERP for
      independent supermarkets. Ten stores run on it now, and it's steady enough that it only takes
      an hour or two of my day. That leaves room for a remote role, either B2B or through an
      Andorra employer of record. If you're building something interesting,{" "}
      <a href="mailto:hi@kopenkin.tech" class={`${link} cursor-grabbing`}>send me an email</a>.
    </p>
  </div>

  <h2 class="appear mt-14 font-display text-lg font-medium" style="--order: 4">Work</h2>
  <ul class="appear mt-4 space-y-4 leading-relaxed" style="--order: 5">
    {
      work.map((item) => (
        <li class="flex gap-6">
          <span class="w-10 shrink-0 text-ash tabular-nums">{item.year}</span>
          <span>{item.text}</span>
        </li>
      ))
    }
  </ul>

  <h2 class="appear mt-14 font-display text-lg font-medium" style="--order: 6">Open source</h2>
  <OpenSource />
</Layout>

<style>
  /* On a fresh load, the text comes into focus block by block, a beat after the painting starts
     to develop. Not when arriving from another page of the site: that already has its own
     transition (see the head script in Layout.astro). */
  @media (prefers-reduced-motion: no-preference) {
    /* Global, so the blocks of components on this page (the open source list) come in too. */
    :global(:root[data-arrival="fresh"] .appear) {
      animation: appear 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(0.35s + var(--order) * 0.08s);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      translate: 0 6px;
      filter: blur(4px);
    }
  }
</style>
