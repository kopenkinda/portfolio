---
import AndorraScene from "../components/andorra/AndorraScene.astro";
import DotsScene from "../components/dots/DotsScene.astro";
import Layout from "../layouts/Layout.astro";

// Placeholder content. Replace with real entries.
const work = [
  { year: "2026", text: "CTO at Salut Mercado, a retail ERP for independent supermarkets" },
  { year: "2024", text: "Built a browser-based CAD viewer used by 7,500+ companies" },
  { year: "2022", text: "Put ML models into surgical triage across 100+ hospitals" },
  { year: "2017", text: "Shipped prototypes, most went nowhere, a few did" },
];

const nav = [
  { label: "Blog", href: "/blog/" },
  { label: "Wall", href: "/wall/" },
];

const link = "underline decoration-accent underline-offset-4 transition-colors hover:decoration-paper";
---

<Layout>
  <!-- One graphic shows, picked by the colours: the painted map or the valley in dots. -->
  <AndorraScene />
  <DotsScene />
  <h1 class="appear mt-10 font-display text-3xl font-medium tracking-tight" style="--order: 0">Dmitrii Kopenkin</h1>
  <nav class="appear mt-3 text-sm text-ash" style="--order: 1">
    <ul class="flex gap-5">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class={link}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-14 space-y-5 leading-relaxed">
    <p class="appear" style="--order: 2">
      I'm a full-stack product engineer in Andorra. I build complete products, from the database
      schema to the feature in a customer's hands. Most of my work is in TypeScript, React, Node,
      Python, Go and Postgres.
    </p>
    <p class="appear" style="--order: 3">
      Right now I'm CTO at <a href="https://salutmercado.com" class={link}>Salut Mercado</a>, where
      we're shipping an ERP to independent supermarkets in Barcelona. If you're building
      something, <a href="mailto:hi@kopenkin.tech" class={`${link} cursor-grabbing`}>send me an email</a>.
    </p>
  </div>

  <h2 class="appear mt-14 font-display text-lg font-medium" style="--order: 4">Work</h2>
  <ul class="appear mt-4 space-y-3 leading-relaxed" style="--order: 5">
    {
      work.map((item) => (
        <li class="flex gap-6">
          <span class="w-10 shrink-0 text-ash tabular-nums">{item.year}</span>
          <span>{item.text}</span>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  /* On a fresh load, the text comes into focus block by block, a beat after the painting starts
     to develop. Not when arriving from another page of the site: that already has its own
     transition (see the head script in Layout.astro). */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-arrival="fresh"]) .appear {
      animation: appear 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(0.35s + var(--order) * 0.08s);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      translate: 0 6px;
      filter: blur(4px);
    }
  }
</style>
