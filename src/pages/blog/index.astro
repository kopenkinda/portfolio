---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BasePage from "../../components/BasePage.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import ScrambleLink from "../../components/ScrambleLink.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { BLOG, CONFIG } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BasePage>
  <Fragment slot="head">
    <BaseHead
      title={`${BLOG.title.toLowerCase()} | ${CONFIG.meta.title}`}
      description={BLOG.subtitle}
    />
  </Fragment>

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-16 sm:pt-16">
    <header>
      <p class="mb-3 text-xs text-muted-foreground">
        <span class="text-accent">$</span> ls ./mind-palace
      </p>
      <h1
        class="text-3xl leading-tight font-bold tracking-tight text-pretty text-foreground sm:text-4xl"
      >
        {BLOG.title.toLowerCase()}
        <span class="animate-blink text-accent">█</span>
      </h1>
      <p
        class="mt-5 max-w-[64ch] text-sm leading-relaxed text-muted-foreground"
      >
        {BLOG.subtitle}
      </p>
      <p class="mt-5 text-sm">
        <ScrambleLink href="/rss.xml" label="rss" external={false} />
      </p>
    </header>

    <section class="mt-12">
      <SectionLabel label="POSTS" />
      <ol>
        {
          posts.map((post, index) => (
            <li class="border-b border-dashed border-border/70 py-5 last:border-0">
              <article>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs text-muted-foreground">
                  <span class="text-accent">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <FormattedDate date={post.data.pubDate} />
                </div>
                <h2 class="mt-2 text-xl leading-tight font-bold text-foreground">
                  <ScrambleLink
                    href={`/blog/${post.id}/`}
                    label={post.data.title.toLowerCase()}
                    external={false}
                  />
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {post.data.description}
                </p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</BasePage>
