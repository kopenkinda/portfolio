---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import BasePage from "../../components/BasePage.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import ScrambleLink from "../../components/ScrambleLink.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { BLOG, CONFIG } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tagCounts = posts.reduce((counts, post) => {
  post.data.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1));
  return counts;
}, new Map<string, number>());
const tags = [...tagCounts.keys()].sort((a, b) => a.localeCompare(b));
---

<BasePage>
  <Fragment slot="head">
    <BaseHead
      title={`${BLOG.title.toLowerCase()} | ${CONFIG.meta.title}`}
      description={BLOG.subtitle}
    />
  </Fragment>

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-16 sm:pt-16">
    <header>
      <p class="mb-3 text-xs text-muted-foreground">
        <span class="text-accent">$</span> ls ./mind-palace
      </p>
      <h1
        class="text-3xl leading-tight font-bold tracking-tight text-pretty text-foreground sm:text-4xl"
      >
        {BLOG.title.toLowerCase()}
        <span class="animate-blink text-accent">█</span>
      </h1>
      <p
        class="mt-5 max-w-[64ch] text-sm leading-relaxed text-muted-foreground"
      >
        {BLOG.subtitle}
      </p>
      <p class="mt-5 text-sm">
        <ScrambleLink href="/rss.xml" label="rss" external={false} />
      </p>
    </header>

    <blog-tag-filter>
      <section class="mt-12">
        <SectionLabel label="POSTS" />
        {
          tags.length > 0 && (
            <div class="mt-5 border-y border-dashed border-border/70 py-3">
              <p class="mb-2 text-xs text-muted-foreground">
                <span class="text-accent">$</span> grep --tag
              </p>
              <div class="flex flex-wrap gap-x-3 gap-y-2 text-xs">
                <button
                  type="button"
                  data-tag-filter="all"
                  data-active="true"
                  aria-pressed="true"
                  class="group text-muted-foreground underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent focus-visible:text-accent focus-visible:decoration-accent focus-visible:outline-none data-[active=true]:text-accent data-[active=true]:decoration-accent"
                >
                  <span
                    aria-hidden="true"
                    class="text-accent opacity-0 group-data-[active=true]:opacity-100"
                  >
                    &gt;
                  </span>{" "}
                  all
                  <span class="text-border">({posts.length})</span>
                </button>
                {tags.map((tag) => (
                  <button
                    type="button"
                    data-tag-filter={tag}
                    data-active="false"
                    aria-pressed="false"
                    class="group text-muted-foreground underline decoration-border decoration-dotted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent focus-visible:text-accent focus-visible:decoration-accent focus-visible:outline-none data-[active=true]:text-accent data-[active=true]:decoration-accent"
                  >
                    <span
                      aria-hidden="true"
                      class="text-accent opacity-0 group-data-[active=true]:opacity-100"
                    >
                      &gt;
                    </span>{" "}
                    #{tag}
                    <span class="text-border">({tagCounts.get(tag)})</span>
                  </button>
                ))}
              </div>
            </div>
          )
        }
        <ol>
          {
            posts.map((post, index) => (
              <li
                data-blog-post
                data-tags={JSON.stringify(post.data.tags)}
                class="border-b border-dashed border-border/70 py-5 last:border-0"
              >
                <article>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs text-muted-foreground">
                    <span class="text-accent">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <FormattedDate date={post.data.pubDate} />
                    {post.data.tags.map((tag) => (
                      <span>
                        <span class="text-border">#</span>
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h2 class="mt-2 text-xl leading-tight font-bold text-foreground">
                    <ScrambleLink
                      href={`/blog/${post.id}/`}
                      label={post.data.title.toLowerCase()}
                      external={false}
                    />
                  </h2>
                  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                    {post.data.description}
                  </p>
                </article>
              </li>
            ))
          }
        </ol>
      </section>
    </blog-tag-filter>
  </main>
</BasePage>

<script>
  class BlogTagFilter extends HTMLElement {
    private buttons: HTMLButtonElement[] = [];
    private posts: HTMLElement[] = [];

    connectedCallback() {
      this.buttons = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"),
      );
      this.posts = Array.from(
        this.querySelectorAll<HTMLElement>("[data-blog-post]"),
      );

      this.buttons.forEach((button) => {
        button.addEventListener("click", this.onClick);
      });
    }

    disconnectedCallback() {
      this.buttons.forEach((button) => {
        button.removeEventListener("click", this.onClick);
      });
    }

    private onClick = (event: Event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      this.setFilter(button.dataset.tagFilter ?? "all");
    };

    private setFilter(tag: string) {
      this.buttons.forEach((button) => {
        const active = button.dataset.tagFilter === tag;
        button.dataset.active = String(active);
        button.setAttribute("aria-pressed", String(active));
      });

      this.posts.forEach((post) => {
        const tags = JSON.parse(post.dataset.tags ?? "[]") as string[];
        post.hidden = tag !== "all" && !tags.includes(tag);
      });
    }
  }

  if (!customElements.get("blog-tag-filter")) {
    customElements.define("blog-tag-filter", BlogTagFilter);
  }
</script>
