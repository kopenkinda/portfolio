---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { postTitleTransition, readingTime } from "../../content.config";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

const post: CollectionEntry<"blog"> = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(post.data.pubDate);
// Unlisted posts are only reachable from the wall, so that's the page one level up.
const back = post.data.unlisted ? { label: "Wall", href: "/wall/" } : { label: "Blog", href: "/blog/" };
---

<Layout title={post.data.title} description={post.data.description} back={back}>
  <article>
    <h1
      class="w-fit font-display text-3xl font-medium tracking-tight [view-transition-class:post-title]"
      style={`view-transition-name: ${postTitleTransition(post.id)}`}
    >
      {post.data.title}
    </h1>
    <p class="mt-2 text-ash">
      <time datetime={post.data.pubDate.toISOString()}>{date}</time> · {readingTime(post.body)}
    </p>
    <div class="prose mt-12">
      <Content />
    </div>
  </article>
</Layout>
